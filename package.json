{
  "name": "varisware-pidev-plugins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Varisware VarisDev Pi/pidev plugins.",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "gts lint",
    "fix": "gts fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop:build": "tsc --project tsconfig.desktop.json",
    "desktop": "npm run desktop:open",
    "desktop:dev": "npm run desktop:build && electron build/desktop/src/desktop/main.js",
    "desktop:install": "npm run desktop:build && node scripts/desktop-app.mjs install",
    "desktop:open": "npm run desktop:build && node scripts/desktop-app.mjs open"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^24.13.2",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.0",
    "json5": "^2.2.3",
    "openai": "^6.0.0",
    "sharp": "^0.35.3",
    "sixel": "0.16.0",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "devDependencies": {
    "gts": "^7.0.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
