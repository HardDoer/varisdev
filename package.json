{
  "name": "varisdev",
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/HardDoer/varisdev.git"
  },
  "homepage": "https://github.com/HardDoer/varisdev#readme",
  "bugs": {
    "url": "https://github.com/HardDoer/varisdev/issues"
  },
  "description": "VarisDev desktop coding app with agents and extensible tools.",
  "bin": {
    "varisdev": "bin/varisdev.mjs"
  },
  "exports": {
    "./visualizations": {
      "types": "./src/visualizations.ts",
      "default": "./desktop/build/src/visualizations.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build-info.json",
    "npm-shrinkwrap.json",
    "bin/",
    "docs/",
    "examples/",
    "CONTRIBUTING.md",
    "src/",
    "extensions/",
    "assets/",
    "scripts/",
    "desktop/package.json",
    "desktop/package-lock.json",
    "tsconfig.desktop.json"
  ],
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "gts lint",
    "fix": "gts fix",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "desktop:build": "tsc --project tsconfig.desktop.json",
    "desktop": "npm run desktop:open",
    "desktop:dev": "npm run desktop:build && electron desktop/build/src/desktop/main.js",
    "desktop:install": "npm run desktop:build && node scripts/desktop-app.mjs install",
    "desktop:open": "npm run desktop:build && node scripts/desktop-app.mjs open",
    "release:web": "node scripts/release-web.mjs",
    "prepare": "node scripts/write-build-info.mjs",
    "postinstall": "node scripts/install-desktop.mjs"
  },
  "dependencies": {
    "@types/node": "^24.13.2",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.7.0",
    "json5": "^2.2.3",
    "npm": "11.11.0",
    "openai": "^6.0.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "gts": "^7.0.0",
    "typebox": "1.3.7"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
