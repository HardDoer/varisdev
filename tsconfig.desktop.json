{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "desktop/build",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "sourceMap": true,
    "paths": {
      "@earendil-works/pi-ai": [
        "./desktop/node_modules/@earendil-works/pi-ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-coding-agent": [
        "./desktop/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
      ],
      "@earendil-works/pi-tui": [
        "./desktop/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
      ],
      "typebox": ["./desktop/node_modules/typebox/build/index.d.mts"]
    }
  },
  "include": ["src/desktop/**/*.ts", "src/**/*.mjs"],
  "exclude": ["build", "desktop", "node_modules"]
}
